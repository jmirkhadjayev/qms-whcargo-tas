# Copy to .env and adjust. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=yuk_navbat
POSTGRES_USER=yuk_navbat
POSTGRES_PASSWORD=yuk_navbat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Channels layer: redis (default) | memory (single process, local development without Redis)
CHANNEL_LAYER=redis

# Local development without Redis/Celery: run tasks inline (never in production)
CELERY_EAGER=false

# Kiosk screens: networks that may open /display/* without a token (comma-separated)
DISPLAY_ALLOWED_IPS=127.0.0.1,::1

# Integration adapters (CLAUDE.md "Tashqi tizimlar")
PERMIT_PROVIDER=mock      # mock | manual | awery (awery: not implemented yet)
SMS_GATEWAY=console       # console | mock
LED_DRIVER=browser

# Demo users password for `make seed` (dev only)
SEED_PASSWORD=change-me-demo
